<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Beauty_Salon.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:strings="clr-namespace:Beauty_Salon.Resources.Strings"
    Title="{x:Static strings:AppResources.HelpTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource Space16}" Spacing="{StaticResource Space12}">

            <VerticalStackLayout Spacing="{StaticResource Space8}" HorizontalOptions="Center" Margin="0,0,0,8">
                <Image Source="help_header.svg" HeightRequest="140" Aspect="AspectFit" />
                <Label Text="{x:Static strings:AppResources.HelpIntro}" Style="{StaticResource BodyLarge}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_agenda.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionAgendaTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionAgendaBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_clients.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionClientsTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionClientsBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_catalog.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionCatalogTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionCatalogBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_sales.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionSalesTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionSalesBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_payments.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionPaymentsTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionPaymentsBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_reports.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionReportsTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionReportsBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_settings.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionSettingsTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionSettingsBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" Padding="{StaticResource Space16}" ColumnSpacing="{StaticResource Space12}">
                            <Image Grid.Column="0" Source="help_faq.svg" HeightRequest="56" WidthRequest="56" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.HelpSectionFaqTitle}" Style="{StaticResource H3}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Label Text="{x:Static strings:AppResources.HelpSectionFaqBody}" Style="{StaticResource BodySmall}" Padding="16,0,16,16" />
                </toolkit:Expander>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
