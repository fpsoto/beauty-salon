<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.felipeparrasoto.beautysalon" android:versionCode="1" android:versionName="0.0.1">
	<!-- Declared explicitly instead of floating to whatever the installed SDK compiles against
	     (API 36 here) - 36 is too new/not yet widely deployed on real devices, and suspected of
	     causing "App not installed" failures when sideloading onto phones running an
	     actually-shipped Android version (e.g. 14). Android 15 (API 35) is stable and current;
	     the app still compiles against the newer API 36 headers, this only changes which
	     behavior-gating version the OS treats the app as targeting. -->
	<uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true" android:label="Beauty Salon"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>